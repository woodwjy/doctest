{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e91\u67a2\u7269\u8054","text":""},{"location":"#_1","title":"\u8ba9\u6bcf\u4e00\u53f0\u8bbe\u5907\uff0c\u90fd\u6210\u4e3a\u4e1a\u52a1\u589e\u957f\u7684\u4e00\u90e8\u5206","text":"<p>\u4e00\u7ad9\u5f0f\u7269\u8054\u7f51\u57fa\u7840\u8bbe\u65bd\u4e0e\u89e3\u51b3\u65b9\u6848\u670d\u52a1\u5546\uff1a\u8fb9\u7f18\u7f51\u5173\u3001\u65e0\u7ebf\u667a\u80fd\u4f20\u611f\u3001IoT \u4e91\u5e73\u53f0\uff0c\u52a9\u529b\u5236\u9020\u4e0e\u80fd\u6e90\u4f01\u4e1a\u5b8c\u6210\u8bbe\u5907\u8054\u7f51\u4e0e\u667a\u80fd\u5316\u5347\u7ea7\u3002</p> \u4e86\u89e3\u4ea7\u54c1 \u884c\u4e1a\u89e3\u51b3\u65b9\u6848 \u5ba2\u6237\u6848\u4f8b"},{"location":"#_2","title":"\u4e3a\u4ec0\u4e48\u9009\u62e9\u4e91\u67a2\u7269\u8054","text":"\u80fd\u529b \u8bf4\u660e \u4e86\u89e3\u66f4\u591a \u8fb9\u7f18\u8ba1\u7b97\u7f51\u5173 EGW-X1 \u591a\u534f\u8bae\u63a5\u5165\u3001\u672c\u5730\u89c4\u5219\u5f15\u64ce\u3001\u65ad\u7f51\u7eed\u4f20 \u67e5\u770b\u8be6\u60c5 \u65e0\u7ebf\u667a\u80fd\u4f20\u611f\u7cfb\u5217 \u514d\u5e03\u7ebf\u90e8\u7f72\u3001\u8d85\u4f4e\u529f\u8017\u3001\u591a\u79cd\u7ec4\u7f51 \u67e5\u770b\u8be6\u60c5 IoT \u4e91\u5e73\u53f0 \u8bbe\u5907\u7ba1\u7406\u3001\u53ef\u89c6\u5316\u3001\u544a\u8b66\u3001\u5f00\u653e API \u67e5\u770b\u8be6\u60c5 \u667a\u6167\u5de5\u5382\u89e3\u51b3\u65b9\u6848 \u8bbe\u5907\u8054\u7f51\u3001OEE \u5206\u6790\u3001\u9884\u6d4b\u6027\u7ef4\u62a4 \u67e5\u770b\u8be6\u60c5 \u5ba2\u6237\u6210\u529f\u5b9e\u8df5 \u5236\u9020 / \u80fd\u6e90 / \u56ed\u533a\u843d\u5730\u6848\u4f8b \u67e5\u770b\u8be6\u60c5"},{"location":"#_3","title":"\u6570\u636e\u6982\u89c8","text":"<p>\u6301\u7eed\u4e3a\u5ba2\u6237\u521b\u9020\u53ef\u91cf\u5316\u7684\u4ef7\u503c\uff1a</p> \u63a5\u5165\u8bbe\u5907 \u670d\u52a1\u5ba2\u6237 \u8986\u76d6\u56ed\u533a \u5e73\u53f0\u53ef\u7528\u6027 120 \u4e07 + 800 + 300 + 99.95%"},{"location":"#_4","title":"\u8054\u7cfb\u6211\u4eec","text":"<p>\u60f3\u4e86\u89e3\u4ea7\u54c1\u9009\u578b\u3001\u7533\u8bf7\u6837\u673a\u6d4b\u8bd5\u6216\u83b7\u53d6\u89e3\u51b3\u65b9\u6848\u8d44\u6599\uff1f\u6b22\u8fce\u8054\u7cfb\u6211\u4eec\uff0c\u6211\u4eec\u5c06\u5728 1 \u4e2a\u5de5\u4f5c\u65e5\u5185\u56de\u590d\u3002</p>"},{"location":"cases/","title":"\u5ba2\u6237\u6848\u4f8b","text":"<p>\u771f\u5b9e\u573a\u666f\u4e0b\u7684\u843d\u5730\u5b9e\u8df5\uff0c\u8ba9\u65b9\u6848\u4ef7\u503c\u53ef\u9a8c\u8bc1\u3001\u53ef\u8861\u91cf\u3002</p>"},{"location":"cases/#_2","title":"\u7cbe\u9009\u6848\u4f8b","text":"\u5ba2\u6237 \u884c\u4e1a \u9879\u76ee\u5185\u5bb9 \u6838\u5fc3\u6210\u679c \u8be6\u7ec6\u4e86\u89e3 \u67d0\u5927\u578b\u6c7d\u8f66\u96f6\u90e8\u4ef6\u96c6\u56e2 \u6c7d\u8f66\u5236\u9020 3 \u5927\u5de5\u5382\u8bbe\u5907\u8054\u7f51\u3001OEE \u770b\u677f \u8bbe\u5907\u8054\u7f51\u7387 92%\uff0cOEE \u63d0\u5347 12% \u67e5\u770b\u8be6\u60c5 \u67d0\u751f\u7269\u533b\u836f\u4f01\u4e1a \u533b\u836f\u5236\u9020 \u6d01\u51c0\u8f66\u95f4\u73af\u5883\u76d1\u6d4b \u6e29\u6e7f\u5ea6\u5408\u89c4\u8bb0\u5f55\u81ea\u52a8\u5316\uff0c\u5ba1\u8ba1\u96f6\u7f3a\u9677 \u6574\u7406\u4e2d \u67d0\u4ea7\u4e1a\u56ed\u533a \u56ed\u533a\u80fd\u6e90 \u591a\u8868\u96c6\u6284\u4e0e\u80fd\u8017\u76d1\u6d4b \u5e74\u8282\u7535 8%\uff0c\u80fd\u8017\u8d26\u5355\u7ebf\u4e0a\u5316 \u6574\u7406\u4e2d"},{"location":"cases/#_3","title":"\u5ba2\u6237\u8bc4\u4ef7","text":"<p>\u4ece\u8bd5\u70b9\u5230 3 \u4e2a\u5de5\u5382\u5168\u9762\u63a8\u5e7f\u53ea\u7528\u4e86 6 \u4e2a\u6708\uff0c\u9879\u76ee\u56e2\u961f\u5bf9\u73b0\u573a\u975e\u5e38\u719f\u6089\uff0c\u4ea7\u7ebf\u8001\u5e08\u5085\u4e5f\u80fd\u76f4\u63a5\u4e0a\u624b\u770b\u677f\u3002\u2014\u2014\u67d0\u6c7d\u8f66\u96f6\u90e8\u4ef6\u96c6\u56e2 CIO</p> <p>\u6700\u770b\u91cd\u7684\u662f\u6570\u636e\u4e0d\u51fa\u56ed\u533a\u7684\u79c1\u6709\u5316\u65b9\u6848\uff0c\u5b89\u5168\u5408\u89c4\u65b9\u9762\u5e2e\u6211\u4eec\u7701\u4e86\u5f88\u591a\u5fc3\u3002\u2014\u2014\u67d0\u4ea7\u4e1a\u56ed\u533a\u4fe1\u606f\u4e2d\u5fc3\u8d1f\u8d23\u4eba</p>"},{"location":"cases/auto-parts-group/","title":"\u67d0\u5927\u578b\u6c7d\u8f66\u96f6\u90e8\u4ef6\u96c6\u56e2\uff1a3 \u5927\u5de5\u5382\u8bbe\u5907\u8054\u7f51\u9879\u76ee","text":""},{"location":"cases/auto-parts-group/#_1","title":"\u5ba2\u6237\u80cc\u666f","text":"<p>\u56fd\u5185\u9886\u5148\u7684\u6c7d\u8f66\u96f6\u90e8\u4ef6\u5236\u9020\u5546\uff0c\u4ea7\u54c1\u8986\u76d6\u53d1\u52a8\u673a\u3001\u53d8\u901f\u7bb1\u6838\u5fc3\u90e8\u4ef6\uff0c\u62e5\u6709 3 \u4e2a\u751f\u4ea7\u57fa\u5730\uff0c\u8bbe\u5907\u4ee5\u6570\u63a7\u673a\u5e8a\u3001\u52a0\u5de5\u4e2d\u5fc3\u3001\u81ea\u52a8\u5316\u4ea7\u7ebf\u4e3a\u4e3b\uff0c\u54c1\u724c\u4e0e\u5e74\u4ee3\u8de8\u5ea6\u5927\u3002</p>"},{"location":"cases/auto-parts-group/#_2","title":"\u9879\u76ee\u75db\u70b9","text":"<ul> <li>\u8bbe\u5907\u54c1\u724c 20+\uff08\u53d1\u90a3\u79d1\u3001\u897f\u95e8\u5b50\u3001\u9a6c\u624e\u514b\u7b49\uff09\uff0c\u534f\u8bae\u4e0d\u7edf\u4e00\uff0c\u6570\u636e\u83b7\u53d6\u56f0\u96be\u3002</li> <li>\u4f9d\u8d56\u4eba\u5de5\u65e5\u62a5\u7edf\u8ba1\u4ea7\u91cf\u4e0e\u505c\u673a\uff0cOEE \u8ba1\u7b97\u53e3\u5f84\u4e0d\u4e00\u81f4\uff0c\u7ba1\u7406\u5c42\u51b3\u7b56\u7f3a\u4e4f\u6570\u636e\u652f\u6491\u3002</li> <li>\u8bbe\u5907\u6545\u969c\u4e8b\u540e\u53d1\u73b0\uff0c\u7ef4\u4fee\u54cd\u5e94\u6162\uff0c\u74f6\u9888\u8bbe\u5907\u505c\u673a\u76f4\u63a5\u5f71\u54cd\u4ea4\u4ed8\u3002</li> </ul>"},{"location":"cases/auto-parts-group/#_3","title":"\u89e3\u51b3\u65b9\u6848","text":"<ul> <li>\u8bbe\u5907\u63a5\u5165\uff1a\u90e8\u7f72 130+ \u53f0\u8fb9\u7f18\u7f51\u5173 EGW-X1\uff0c\u901a\u8fc7\u6570\u63a7\u7cfb\u7edf\u901a\u8baf\u4e0e PLC \u534f\u8bae\u91c7\u96c6 2000+ \u53f0\u8bbe\u5907\u8fd0\u884c\u6570\u636e\u3002</li> <li>\u5e73\u53f0\u5efa\u8bbe\uff1a\u79c1\u6709\u5316\u90e8\u7f72 IoT \u4e91\u5e73\u53f0\uff0c\u6784\u5efa\u4ea7\u7ebf / \u8f66\u95f4 / \u5de5\u5382\u4e09\u7ea7\u76d1\u63a7\u5927\u5c4f\u4e0e OEE \u5206\u6790\u62a5\u8868\u3002</li> <li>\u544a\u8b66\u95ed\u73af\uff1a\u8bbe\u5907\u5f02\u5e38\u5b9e\u65f6\u63a8\u9001\u81f3\u73ed\u7ec4\u957f\u4e0e\u7ef4\u4fee\u56e2\u961f\uff0c\u5173\u8054\u7ef4\u4fee\u5de5\u5355\u5f62\u6210\u95ed\u73af\u3002</li> <li>\u7cfb\u7edf\u96c6\u6210\uff1a\u5e73\u53f0\u4e0e\u73b0\u6709 MES\u3001ERP \u6253\u901a\uff0c\u751f\u4ea7\u6392\u4ea7\u4e0e\u8bbe\u5907\u72b6\u6001\u5b9e\u65f6\u8054\u52a8\u3002</li> </ul>"},{"location":"cases/auto-parts-group/#_4","title":"\u5b9e\u65bd\u6210\u6548","text":"\u6307\u6807 \u6539\u5584\u7ed3\u679c \u8bbe\u5907\u8054\u7f51\u7387 \u4ece 30% \u63d0\u5347\u81f3 92% \u7efc\u5408\u8bbe\u5907\u6548\u7387 OEE \u5e73\u5747\u63d0\u5347 12% \u8bbe\u5907\u6545\u969c\u5e73\u5747\u54cd\u5e94\u65f6\u957f \u7f29\u77ed 45% \u6570\u636e\u7edf\u8ba1\u4eba\u5de5\u6295\u5165 \u51cf\u5c11 70%"},{"location":"cases/auto-parts-group/#_5","title":"\u5ba2\u6237\u53cd\u9988","text":"<p>\u73b0\u5728\u6bcf\u5929\u65e9\u4e0a\u5f00\u751f\u4ea7\u4f1a\uff0c\u5927\u5bb6\u770b\u7684\u662f\u540c\u4e00\u4e2a\u5b9e\u65f6\u6570\u636e\uff0c\u4e89\u8bae\u5c11\u4e86\uff0c\u95ee\u9898\u5b9a\u4f4d\u5feb\u4e86\u3002\u4e8c\u671f\u6211\u4eec\u8ba1\u5212\u628a\u9884\u6d4b\u6027\u7ef4\u62a4\u4e5f\u505a\u8d77\u6765\u3002\u2014\u2014\u9879\u76ee\u8d1f\u8d23\u4eba</p>"},{"location":"cases/auto-parts-group/#_6","title":"\u9879\u76ee\u4eae\u70b9","text":"<ul> <li>\u8fb9\u4e91\u534f\u540c\u67b6\u6784\uff0c\u73b0\u573a\u65ad\u7f51\u4e0d\u5f71\u54cd\u672c\u5730\u6570\u636e\u91c7\u96c6\u4e0e\u5c55\u793a\u3002</li> <li>\u5b58\u91cf\u8bbe\u5907\u5229\u65e7\u6539\u9020\uff0c\u672a\u66f4\u6362\u4efb\u4f55\u751f\u4ea7\u8bbe\u5907\u672c\u4f53\u3002</li> <li>\u5206\u9636\u6bb5\u5b9e\u65bd\uff0c\u9996\u4e2a\u5de5\u5382 3 \u4e2a\u6708\u4e0a\u7ebf\uff0c\u968f\u540e\u5feb\u901f\u590d\u5236\u63a8\u5e7f\u3002</li> </ul>"},{"location":"company/about/","title":"\u5173\u4e8e\u4e91\u67a2\u7269\u8054","text":"<p>\u4e91\u67a2\u7269\u8054\u6210\u7acb\u4e8e 2016 \u5e74\uff0c\u662f\u4e00\u5bb6\u4e13\u6ce8\u4e8e\u7269\u8054\u7f51\u57fa\u7840\u8bbe\u65bd\u4e0e\u884c\u4e1a\u89e3\u51b3\u65b9\u6848\u7684\u56fd\u5bb6\u7ea7\u9ad8\u65b0\u6280\u672f\u4f01\u4e1a\u3002\u516c\u53f8\u4ee5\"\u8ba9\u6570\u636e\u9a71\u52a8\u5de5\u4e1a\u8fdb\u6b65\"\u4e3a\u4f7f\u547d\uff0c\u670d\u52a1\u5236\u9020\u3001\u80fd\u6e90\u3001\u56ed\u533a\u7b49\u884c\u4e1a\u7684\u8bbe\u5907\u8054\u7f51\u4e0e\u6570\u5b57\u5316\u8f6c\u578b\u3002</p>"},{"location":"company/about/#_2","title":"\u6838\u5fc3\u6570\u636e","text":"\u5458\u5de5\u89c4\u6a21 \u7814\u53d1\u5360\u6bd4 \u77e5\u8bc6\u4ea7\u6743 \u670d\u52a1\u5ba2\u6237 300 + 55% 200 + 800 +"},{"location":"company/about/#_3","title":"\u53d1\u5c55\u5386\u7a0b","text":"<ul> <li>2016 \u516c\u53f8\u6210\u7acb\uff0c\u805a\u7126\u5de5\u4e1a\u6570\u636e\u91c7\u96c6\u7f51\u5173\u7814\u53d1\u3002</li> <li>2018 \u53d1\u5e03\u81ea\u7814 IoT \u4e91\u5e73\u53f0\uff0c\u5b8c\u6210\u9996\u8f6e\u878d\u8d44\u3002</li> <li>2020 \u65e0\u7ebf\u4f20\u611f\u4ea7\u54c1\u7ebf\u91cf\u4ea7\uff0c\u8986\u76d6\u8bbe\u5907\u72b6\u6001\u76d1\u6d4b\u573a\u666f\u3002</li> <li>2022 \u83b7\u5f97\u56fd\u5bb6\u7ea7\u4e13\u7cbe\u7279\u65b0\"\u5c0f\u5de8\u4eba\"\u4f01\u4e1a\u8ba4\u5b9a\uff08\u793a\u4f8b\uff0c\u6309\u5b9e\u66f4\u65b0\uff09\u3002</li> <li>2024 \u6d77\u5916\u5e02\u573a\u62d3\u5c55\uff0c\u670d\u52a1\u5ba2\u6237\u7a81\u7834 800 \u5bb6\u3002</li> </ul>"},{"location":"company/about/#_4","title":"\u8d44\u8d28\u8363\u8a89\uff08\u793a\u4f8b\uff0c\u8bf7\u66f4\u65b0\uff09","text":"<ul> <li>\u56fd\u5bb6\u9ad8\u65b0\u6280\u672f\u4f01\u4e1a</li> <li>\u8f6f\u4ef6\u4f01\u4e1a / ISO 9001 / ISO 27001 \u8ba4\u8bc1</li> <li>\u591a\u9879\u53d1\u660e\u4e13\u5229\u4e0e\u8f6f\u4ef6\u8457\u4f5c\u6743</li> </ul>"},{"location":"company/about/#_5","title":"\u7814\u53d1\u4e0e\u521b\u65b0","text":"<p>\u5728\u5317\u4eac\u3001\u6df1\u5733\u8bbe\u6709\u7814\u53d1\u4e2d\u5fc3\uff0c\u805a\u7126\u8fb9\u7f18\u8ba1\u7b97\u3001\u4f4e\