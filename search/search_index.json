0e8\u7f72\u3001\u8054\u8c03\u4e0a\u7ebf\u3001\u4eba\u5458\u57f9\u8bad\u3002</li> <li>\u6301\u7eed\u8fd0\u8425\uff1a7\u00d724 \u76d1\u63a7\u3001\u5b9a\u671f\u5de1\u68c0\u4e0e\u4f18\u5316\u5efa\u8bae\u3002</li> </ol>"},{"location":"solutions/#_4","title":"\u751f\u6001\u4f19\u4f34","text":"<p>\u4e0e\u7cfb\u7edf\u96c6\u6210\u5546\u3001\u4e91\u5382\u5546\u3001\u8fd0\u8425\u5546\u7b49\u5efa\u7acb\u5408\u4f5c\u5173\u7cfb\uff0c\u652f\u6301\u8054\u5408\u6295\u6807\u4e0e\u96c6\u6210\u4ea4\u4ed8\u3002</p>"},{"location":"solutions/smart-manufacturing/","title":"\u667a\u6167\u5de5\u5382\u8bbe\u5907\u8054\u7f51\u89e3\u51b3\u65b9\u6848","text":"<p>\u5e2e\u52a9\u5236\u9020\u4f01\u4e1a\u6253\u901a\u4ece\u8bbe\u5907\u5c42\u5230\u7ba1\u7406\u5c42\u7684\u6570\u636e\u94fe\u8def\uff0c\u89e3\u51b3\"\u8bbe\u5907\u6570\u636e\u770b\u4e0d\u89c1\u3001\u4ea7\u80fd\u6d6a\u8d39\u627e\u4e0d\u5230\u3001\u6545\u969c\u505c\u673a\u9760\u7ecf\u9a8c\"\u4e09\u5927\u75db\u70b9\u3002</p>"},{"location":"solutions/smart-manufacturing/#_2","title":"\u4e1a\u52a1\u75db\u70b9","text":"<ul> <li>\u4ea7\u7ebf\u8bbe\u5907\u54c1\u724c\u7e41\u6742\uff08PLC\u3001\u6570\u63a7\u3001\u4e13\u673a\uff09\uff0c\u534f\u8bae\u4e0d\u7edf\u4e00\uff0c\u6570\u636e\u91c7\u96c6\u96be\u3002</li> <li>\u8bbe\u5907\u72b6\u6001\u9760\u4eba\u5de5\u70b9\u68c0\u8bb0\u5f55\uff0cOEE \u7edf\u8ba1\u5931\u771f\uff0c\u5f02\u5e38\u53d1\u73b0\u6ede\u540e\u3002</li> <li>\u8bbe\u5907\u6545\u969c\u4e8b\u540e\u7ef4\u4fee\uff0c\u975e\u8ba1\u5212\u505c\u673a\u9020\u6210\u4ea7\u80fd\u635f\u5931\u3002</li> </ul>"},{"location":"solutions/smart-manufacturing/#_3","title":"\u65b9\u6848\u67b6\u6784","text":"<pre><code>\u7ba1\u7406\u5c42     MES / ERP / BI \u7cfb\u7edf\n          \u25b2        \u25b2\n\u4e91\u5e73\u53f0     \u4e91\u67a2 IoT \u4e91\u5e73\u53f0\uff08\u8bbe\u5907\u7ba1\u7406 \u00b7 \u53ef\u89c6\u5316 \u00b7 \u544a\u8b66 \u00b7 \u5206\u6790\uff09\n          \u25b2        \u25b2\n\u8fb9\u7f18\u5c42     \u8fb9\u7f18\u8ba1\u7b97\u7f51\u5173 EGW-X1\uff08\u534f\u8bae\u8f6c\u6362 \u00b7 \u8fb9\u7f18\u89c4\u5219 \u00b7 \u65ad\u7f51\u7eed\u4f20\uff09\n          \u25b2        \u25b2\n\u8bbe\u5907\u5c42     PLC / \u6570\u63a7 / \u673a\u5668\u4eba / \u7535\u8868 / \u632f\u52a8\u4f20\u611f / \u6e29\u6e7f\u5ea6\u4f20\u611f\n</code></pre> <ul> <li>\u8bbe\u5907\u5c42\uff1a\u901a\u8fc7\u7f51\u5173\u591a\u534f\u8bae\u91c7\u96c6\uff0c\u65e0\u7ebf\u4f20\u611f\u8865\u5145\u6d4b\u70b9\u3002</li> <li>\u8fb9\u7f18\u5c42\uff1a\u672c\u5730\u89e3\u6790\u4e0e\u8fb9\u7f18\u8ba1\u7b97\uff0c\u964d\u4f4e\u5e26\u5bbd\u4e0e\u4e91\u7aef\u538b\u529b\u3002</li> <li>\u4e91\u5e73\u53f0\uff1a\u6c47\u805a\u6570\u636e\uff0c\u652f\u6491\u5927\u5c4f\u76d1\u63a7\u3001\u544a\u8b66\u3001\u5206\u6790\u4e0e\u4e1a\u52a1\u7cfb\u7edf\u5bf9\u63a5\u3002</li> </ul>"},{"location":"solutions/smart-manufacturing/#_4","title":"\u5e94\u7528\u573a\u666f","text":""},{"location":"solutions/smart-manufacturing/#_5","title":"\u751f\u4ea7\u72b6\u6001\u900f\u660e\u5316","text":"<p>\u5b9e\u65f6\u5c55\u793a\u4ea7\u7ebf\u8fd0\u884c / \u5f85\u673a / \u6545\u969c\u72b6\u6001\uff0c\u81ea\u52a8\u8ba1\u7b97\u65f6\u95f4\u5f00\u52a8\u7387\u3001\u6027\u80fd\u5f00\u52a8\u7387\u4e0e OEE\uff0c\u5f02\u5e38\u81ea\u52a8\u63a8\u9001\u81f3\u8d23\u4efb\u4eba\u3002</p>"},{"location":"solutions/smart-manufacturing/#_6","title":"\u9884\u6d4b\u6027\u7ef4\u62a4","text":"<p>\u57fa\u4e8e\u632f\u52a8\u3001\u6e29\u5ea6\u3001\u7535\u6d41\u6570\u636e\u5efa\u7acb\u8bbe\u5907\u5065\u5eb7\u6a21\u578b\uff0c\u63d0\u524d\u9884\u8b66\u8f74\u627f\u78e8\u635f\u3001\u6da6\u6ed1\u4e0d\u826f\u7b49\u9690\u60a3\uff0c\u5c06\u4e8b\u540e\u7ef4\u4fee\u53d8\u4e3a\u4e8b\u524d\u7ef4\u62a4\u3002</p>"},{"location":"solutions/smart-manufacturing/#_7","title":"\u80fd\u8017\u7cbe\u7ec6\u7ba1\u7406","text":"<p>\u5206\u8bbe\u5907 / \u5206\u4ea7\u7ebf\u8ba1\u91cf\u7535\u8017\uff0c\u8bc6\u522b\u7a7a\u8f6c\u3001\u5f85\u673a\u6d6a\u8d39\uff0c\u652f\u6491\u8282\u80fd\u6539\u9020\u4e0e\u6210\u672c\u6838\u7b97\u3002</p>"},{"location":"solutions/smart-manufacturing/#_8","title":"\u5b9e\u65bd\u6210\u6548\uff08\u793a\u4f8b\u6307\u6807\uff09","text":"\u6307\u6807 \u6539\u5584\u5e45\u5ea6 \u8bbe\u5907\u7efc\u5408\u6548\u7387 OEE \u63d0\u5347 8~15% \u975e\u8ba1\u5212\u505c\u673a\u65f6\u957f \u964d\u4f4e 20~40% \u70b9\u68c0\u8bb0\u5f55\u4eba\u5de5\u6295\u5165 \u51cf\u5c11 60% \u4ee5\u4e0a"}]}